{
  "name": "lumen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "pnpm --filter @lumen/web dev",
    "preview": "pnpm --filter @lumen/web preview",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @lumen/web test:e2e",
    "build": "pnpm -r --if-present run build",
    "content:validate": "pnpm --filter @lumen/content-pipeline validate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
